        { "source": "単価", "target": "price", "required": false },
        { "source": "勤務地", "target": "location", "required": false },
        { "source": "リモート", "target": "remote_type", "required": false },
        { "source": "開始時期", "target": "start_date", "required": false },
        { "source": "備考", "target": "note", "required": false }
      ]
    },
    {
      "partner_id": "PARTNER_B",
      "data_type": "engineer",
      "config": [
        { "source": "氏名", "target": "name", "required": true },
        { "source": "職種", "target": "role", "required": false },
        { "source": "年齢", "target": "age", "required": false },
        { "source": "最寄り", "target": "nearest_station", "required": false },
        { "source": "スキル", "target": "skills", "required": true },
        { "source": "希望単価", "target": "price", "required": false },
